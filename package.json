{
  "name": "voyan-travel",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:all": "start \"Voyan Backend\" cmd /k npm run backend:dev && npm run dev",
    "start": "vite preview --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "node -e \"const fs = require('fs'); ['dist', 'server.js'].forEach(p => fs.rmSync(p, { recursive: true, force: true }));\"",
    "lint": "tsc --noEmit",
    "cap:sync": "npm run build && cap sync",
    "backend:dev": "mvnw.cmd -f java-backend/pom.xml spring-boot:run",
    "backend:build": "mvnw.cmd -f java-backend/pom.xml package"
  },
  "dependencies": {
    "@capacitor-community/background-geolocation": "^1.3.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/local-notifications": "^8.1.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/google.maps": "^3.66.7",
    "@vis.gl/react-google-maps": "^1.10.1",
    "@vitejs/plugin-react": "^6.1.1",
    "firebase": "^13.0.0",
    "jose": "^6.2.13",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^2.0.0"
  }
}
